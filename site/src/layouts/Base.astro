---
import type { Locale } from "../lib/data";
import { getPathByLocale, translate } from "../i18n/translate";

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const t = translate(locale);
const pageTitle = title ? `${title} · ${t("site.name")}` : t("site.subtitle");
const isZh = locale === "zh" || locale === "zh-TW";

const langLinks = [
  { code: "zh", label: "简体" },
  { code: "zh-TW", label: "繁體" },
];
const categories = ["世态人情", "鬼怪神魔", "历史演义", "英雄传奇", "谴责公案", "传奇小说", "其他"];
const currentLang = langLinks.find((l) => l.code === locale)!;

function hrefIn(loc: Locale, path: string) {
  const clean = path.startsWith("/") ? path.slice(1) : path;
  return `/${loc}/${clean}`;
}
function currentPathTarget(code: Locale) {
  return getPathByLocale(Astro.url.pathname, locale, code);
}
const pathname = Astro.url.pathname;
const base = `/${locale}`;
function isActive(seg: string) {
  const underLibrary =
    pathname.startsWith(`${base}/library`) ||
    pathname.startsWith(`${base}/book/`) ||
    pathname.startsWith(`${base}/read/`);
  if (seg === "home") return pathname === `${base}/` || pathname === base;
  if (seg === "library") return underLibrary;
  if (seg === "categories") return false;
  if (seg === "authors") return pathname.startsWith(`${base}/author`);
  if (seg === "about") return pathname.startsWith(`${base}/about`);
  return false;
}
const homeHref = hrefIn(locale, "/");
const libraryHref = hrefIn(locale, "/library");
const authorsHref = hrefIn(locale, "/author");
const aboutHref = hrefIn(locale, "/about");
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : locale === "zh-TW" ? "zh-Hant" : locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ece3ce" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t("site.subtitle")} />
    <link
      rel="stylesheet"
      href="https://fonts.loli.net/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Serif+JP:wght@400;600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=LXGW+WenKai&display=swap"
    />
    <link rel="preconnect" href="https://fonts.loli.net" crossorigin />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body data-theme="xuan">
    <a class="skip-link" href="#main">{t("a11y.skip")}</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="brand" href={hrefIn(locale, "/")}>
          <span class="brand-seal" aria-hidden="true">典</span>
          <span class="brand-txt">{isZh ? t("site.name") : "Chinese Classical Novels"}</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a
            class={isActive("home") ? "is-active" : undefined}
            href={homeHref}
            aria-current={isActive("home") ? "page" : undefined}
          >
            {t("nav.home")}
          </a>
          <a
            class={isActive("library") ? "is-active" : undefined}
            href={libraryHref}
            aria-current={isActive("library") ? "page" : undefined}
          >
            {t("nav.library")}
          </a>
          <div class="drop" data-drop>
            <button
              type="button"
              class="drop-trigger nav-link"
              aria-haspopup="true"
              aria-expanded="false"
              data-drop-toggle
              data-cat-toggle
            >
              <span>{t("nav.categories")}</span>
              <span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class="drop-menu categories" data-drop-panel hidden>
              {
                categories.map((ty) => (
                  <a href={`${base}/library?type=${encodeURIComponent(ty)}`}>
                    <span class="dm-name">{ty}</span>
                  </a>
                ))
              }
            </div>
          </div>
          <a
            class={isActive("authors") ? "is-active" : undefined}
            href={authorsHref}
            aria-current={isActive("authors") ? "page" : undefined}
          >
            {t("nav.authors")}
          </a>
          <a
            class={isActive("about") ? "is-active" : undefined}
            href={aboutHref}
            aria-current={isActive("about") ? "page" : undefined}
          >
            {t("nav.about")}
          </a>
        </nav>
        <div class="lang" role="navigation" aria-label={t("nav.langLabel")}>
          <div class="drop" data-drop>
            <button
              type="button"
              class="drop-trigger lang-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              data-drop-toggle
            >
              <span class="lang-current">{currentLang.label}</span>
              <span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class="drop-menu lang-menu" data-drop-panel hidden>
              {
                langLinks.map((l) => (
                  <a
                    class={l.code === locale ? "is-active" : undefined}
                    href={currentPathTarget(l.code as Locale)}
                    aria-current={l.code === locale ? "page" : undefined}
                  >
                    <span class="dm-name">{l.label}</span>
                    <span class="dm-name-locale">{l.code === "zh" ? "简体中文" : "繁體中文"}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <span class="brand-seal" aria-hidden="true">典</span>
        <span class="footer-text">{t("site.name")}</span>
        <span class="footer-en">· {new Date().getFullYear()}</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var params = new URLSearchParams(location.search);
        var type = params.get("type");
        var nav = document.querySelector(".nav");
        var catToggle = nav && nav.querySelector("[data-cat-toggle]");
        if (type && catToggle) {
          nav.querySelectorAll("a").forEach(function (el) {
            el.classList.remove("is-active");
          });
          catToggle.classList.add("is-active");
        }
        var drops = document.querySelectorAll("[data-drop]");
        function closeAll(except) {
          drops.forEach(function (d) {
            if (d !== except) {
              d.setAttribute("data-open", "false");
              var t = d.querySelector("[data-drop-toggle]");
              if (t) t.setAttribute("aria-expanded", "false");
              var p = d.querySelector("[data-drop-panel]");
              if (p) p.hidden = true;
            }
          });
        }
        drops.forEach(function (d) {
          var toggle = d.querySelector("[data-drop-toggle]");
          var panel = d.querySelector("[data-drop-panel]");
          if (!toggle || !panel) return;
          toggle.addEventListener("click", function (e) {
            e.stopPropagation();
            var open = d.getAttribute("data-open") === "true";
            closeAll(d);
            var nextOpen = !open;
            d.setAttribute("data-open", nextOpen ? "true" : "false");
            toggle.setAttribute("aria-expanded", String(nextOpen));
            panel.hidden = !nextOpen;
          });
        });
        document.addEventListener("click", function () {
          closeAll();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeAll();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
  }
  .skip-link:focus {
    left: 8px;
    top: 8px;
    background: var(--cinnabar);
    color: var(--paper);
    padding: 0.35rem 0.75rem;
    z-index: 999;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: var(--hairline) var(--line);
  }
  .masthead-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.7rem var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
  }
  .brand-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: var(--cinnabar);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.1rem;
    border-radius: 3px;
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 3px var(--cinnabar),
      var(--shadow-glow-cinnabar);
    transition: box-shadow 0.3s ease;
  }
  .brand:hover .brand-seal {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 3px var(--cinnabar),
      0 0 28px rgba(179, 54, 47, 0.3);
  }
  .brand-en {
    font-family: var(--font-latin-display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    font-style: italic;
    color: var(--text-dim);
  }
  .brand-txt {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--text);
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    margin-left: auto;
  }
  .nav-link {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--text);
    padding: 0.2rem 0.1rem;
    border-bottom: 2px solid transparent;
    background: none;
    border-inline: none;
    border-top: none;
    border-radius: 0;
    box-shadow: none;
  }
  .nav a {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--text);
    padding: 0.2rem 0.1rem;
  }
  .nav a,
  .nav-link {
    text-decoration: none;
    cursor: pointer;
  }
  .nav a:hover,
  .nav-link:hover {
    color: var(--cinnabar);
    border-bottom-color: transparent;
  }
  .nav .is-active,
  .drop-trigger.is-active {
    color: var(--cinnabar);
    border-bottom-color: var(--cinnabar);
  }
  .nav .is-active:hover,
  .drop-trigger.is-active:hover,
  .nav a.is-active:hover {
    color: var(--cinnabar-bright);
  }

  /* ── dropdowns ─────────────────────────────── */
  .drop {
    position: relative;
    display: inline-flex;
  }
  .drop-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--text);
    padding: 0.2rem 0.1rem;
    background: none;
    border: none;
    cursor: pointer;
  }
  .drop-trigger.nav-link {
    border-inline: none;
    border-top: none;
    border-bottom: 2px solid transparent;
  }
  .drop-trigger:hover {
    color: var(--cinnabar);
  }
  .drop[data-open="true"] .drop-trigger {
    color: var(--cinnabar);
    border-bottom: 2px solid var(--gold);
  }
  .drop-menu[hidden] {
    display: none;
  }
  .drop-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 220px;
    background: var(--bg-panel);
    border: var(--hairline) var(--line);
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    padding: 0.4rem;
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .drop-menu a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .drop-menu a:hover {
    background: var(--bg-panel-2);
    color: var(--cinnabar);
  }
  .drop-menu a.is-active {
    color: var(--cinnabar);
    background: var(--bg-panel);
  }
  .dm-name {
    font-family: var(--font-display);
  }
  .dm-name-locale {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  .lang {
    display: flex;
    align-items: center;
  }
  .lang .drop {
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  .lang-trigger {
    font-size: var(--fs-sm);
    color: var(--text-dim);
    padding: 0.3rem 0.55rem;
    border: var(--hairline) var(--line);
    border-radius: var(--radius);
    background: transparent;
  }
  .lang-trigger:hover {
    color: var(--text);
    border-color: var(--gold);
  }
  .lang .drop[data-open="true"] .lang-trigger {
    border-color: var(--cinnabar);
    color: var(--cinnabar);
  }
  .lang-menu {
    right: 0;
    left: auto;
    text-align: left;
  }
  .caret {
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }
  .lang-current {
    letter-spacing: 0.03em;
  }

  @media (max-width: 860px) {
    .masthead-inner {
      gap: var(--space-3);
      padding: 0.55rem var(--space-4);
    }
    .brand-en {
      display: none;
    }
    .brand-txt {
      font-size: 1rem;
    }
    .nav {
      gap: var(--space-3);
    }
    .nav-link,
    .nav a,
    .drop-trigger {
      font-size: var(--fs-base);
    }
    .drop-menu.categories {
      left: auto;
      right: 0;
    }
  }
  @media (max-width: 560px) {
    .brand-seal {
      width: 1.6rem;
      height: 1.6rem;
      font-size: 0.95rem;
    }
    .masthead-inner {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }
    .brand-txt {
      font-size: 0.95rem;
    }
    .lang {
      margin-left: auto;
    }
    /* nav drops to its own row, horizontally scrollable */
    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      gap: var(--space-4);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .drop-menu {
      min-width: 180px;
    }
  }

  .footer {
    margin-top: var(--space-8);
    border: none;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--line) 15%,
      var(--gold-dim) 50%,
      var(--line) 85%,
      transparent 100%
    );
    height: 1px;
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-5);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-dim);
    font-size: var(--fs-sm);
  }
  .footer-inner .brand-seal {
    width: 1.3rem;
    height: 1.3rem;
    font-size: 0.8rem;
  }
</style>
