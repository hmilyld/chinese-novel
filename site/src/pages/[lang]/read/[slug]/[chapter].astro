---
import { getCollection } from "astro:content";
import type { Locale } from "../../../../lib/data";
import Base from "../../../../layouts/Base.astro";
import { translate } from "../../../../i18n/translate";
import { readChapterBody, parseChapter, readChapters } from "../../../../lib/data";

export async function getStaticPaths() {
  const books = await getCollection("books");
  const langs: Locale[] = ["zh", "zh-TW"];
  const paths: {
    params: { lang: string; slug: string; chapter: string };
    props: any;
  }[] = [];
  for (const lang of langs) {
    for (const b of books) {
      const chapters = readChapters(b.data.id, lang);
      if (!chapters) continue;
      for (const c of chapters) {
        paths.push({
          params: {
            lang,
            slug: b.data.slug,
            chapter: String(c.index),
          },
          props: {
            locale: lang,
            bookId: b.data.id,
            bookName: b.data.name,
            bookSlug: b.data.slug,
            chapters,
            chapterIndex: c.index,
          },
        });
      }
    }
  }
  return paths;
}

const { locale, bookId, bookName, bookSlug, chapters, chapterIndex } =
  Astro.props;
const t = translate(locale);
const base = `/${locale}`;

const chapter = chapters[chapterIndex];

const md = readChapterBody(locale, bookId, chapter.file) ??
  readChapterBody("zh", bookId, chapter.file);
const parsed = md ? parseChapter(md) : null;
const title = parsed?.title ?? chapter.title;

const prev = chapterIndex > 0 ? chapters[chapterIndex - 1] : null;
const next =
  chapterIndex < chapters.length - 1 ? chapters[chapterIndex + 1] : null;

const progressPct = Math.round(
  ((chapterIndex + 1) / chapters.length) * 100
);

// couplet halves for the header — titles split on full-width spaces / 第N回
const coupParts = title
  .replace(/^第[一二三四五六七八九十百]+回\s*/, "")
  .split(/[\s\u3000\xa0]+/)
  .filter(Boolean);
---

<Base locale={locale} title={`${title} · ${bookName}`}>
  <div class="reader">
    <div class="reader-top">
      <header class="reader-bar">
      <div class="rb-left">
        <a class="rb-toc" href={`${base}/book/${bookSlug}`}>
          <span aria-hidden="true">☰</span>
          <span>{t("reader.toc")}</span>
        </a>
        <a class="rb-book" href={`${base}/book/${bookSlug}`}>
          {bookName}
        </a>
      </div>
      <div class="rb-center">
        <span class="rb-progress">{t("reader.progress").replace("{i}", String(chapterIndex + 1)).replace("{n}", String(chapters.length))}</span>
      </div>
      <div class="rb-right">
        {locale === "zh" && (
          <button
            type="button"
            class="rb-btn"
            data-cmd="theme"
            aria-label={t("reader.theme")}
            title={t("reader.theme")}
          >
            笺
          </button>
        )}
        <button
          type="button"
          class="rb-btn"
          data-cmd="dir"
          aria-label={t("reader.vertical")}
          title={t("reader.vertical")}
        >
          竖
        </button>
        <button
          type="button"
          class="rb-btn"
          data-cmd="minus"
          aria-label={t("reader.fontSmaller")}
          title={t("reader.fontSmaller")}
        >
          A−
        </button>
        <button
          type="button"
          class="rb-btn"
          data-cmd="plus"
          aria-label={t("reader.fontLarger")}
          title={t("reader.fontLarger")}
        >
          A+
        </button>
      </div>
      </header>

      <div class="progress-track" aria-hidden="true">
        <span style={`width:${progressPct}%`}></span>
      </div>
    </div>

    <main class="reading-sheet" data-dir="h" id="sheet">
      <div class="sheet-head">
        {coupParts.length === 2 ? (
          <div class="sheet-coup">
            <span class="sc-half">{coupParts[0]}</span>
            <span class="sc-sep" aria-hidden="true"></span>
            <span class="sc-half">{coupParts[1]}</span>
          </div>
        ) : (
          <div class="sheet-coup single">
            <span class="sc-half">{title}</span>
          </div>
        )}
        <span class="sheet-chapter">{t("reader.progress").replace("{i}", String(chapterIndex + 1)).replace("{n}", String(chapters.length))}</span>
      </div>

      <div class="sheet-body">
        {parsed?.body.map((para) =>
          para.trim() ? <p>{para.trim()}</p> : null
        )}
      </div>

      <nav class="sheet-nav" aria-label="chapter">
        {prev ? (
          <a
            class="nav-prev"
            href={`${base}/read/${bookSlug}/${prev.index}`}
          >
            <span class="nav-label">{t("reader.prev")}</span>
            <span class="nav-title">{prev.title}</span>
          </a>
        ) : (
          <span class="nav-prev is-end"></span>
        )}
        <a class="nav-next" href={next ? `${base}/read/${bookSlug}/${next.index}` : `${base}/book/${bookSlug}`}>
          <span class="nav-label">{next ? t("reader.next") : t("reader.backToBook")}</span>
          <span class="nav-title">{next ? next.title : bookName}</span>
        </a>
      </nav>
    </main>
  </div>
</Base>

<script is:inline>
  (function () {
    var sheet = document.getElementById("sheet");
    var KEY = "shuge:reader";
    var state = { dir: "h", theme: "xuan", size: 1 };
    try {
      state = Object.assign(state, JSON.parse(localStorage.getItem(KEY)));
    } catch (e) {}
    apply();
    var masthead = document.querySelector(".masthead");
    function syncMastheadH() {
      if (masthead) {
        document.documentElement.style.setProperty(
          "--masthead-h",
          masthead.offsetHeight + "px"
        );
      }
    }
    syncMastheadH();
    window.addEventListener("resize", syncMastheadH);
    if (window.ResizeObserver && masthead) {
      new ResizeObserver(syncMastheadH).observe(masthead);
    }
    document.querySelectorAll("[data-cmd]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var cmd = btn.getAttribute("data-cmd");
        if (cmd === "dir") {
          state.dir = state.dir === "h" ? "v" : "h";
        } else if (cmd === "theme") {
          state.theme = state.theme === "moji" ? "xuan" : "moji";
        } else if (cmd === "minus") {
          state.size = Math.max(0.8, state.size - 0.1);
        } else if (cmd === "plus") {
          state.size = Math.min(1.6, state.size + 0.1);
        }
        localStorage.setItem(KEY, JSON.stringify(state));
        apply();
      });
    });
    function apply() {
      sheet.setAttribute("data-dir", state.dir);
      sheet.style.setProperty("--type-scale", String(state.size));
      document.body.setAttribute("data-theme", state.theme);
      var dirBtn = document.querySelector('[data-cmd="dir"]');
      if (dirBtn) dirBtn.textContent = state.dir === "v" ? "横" : "竖";
    }
  })();
</script>

<style is:global>
  body[data-theme="moji"] .reader {
    background: var(--ink);
  }
  body[data-theme="xuan"] .reader {
    background: var(--paper);
  }
</style>

<style>
  .reader {
    min-height: calc(100vh - 200px);
  }
  .reader-top {
    position: sticky;
    top: var(--masthead-h, 56px);
    z-index: 40;
    background: var(--bg);
  }
  .reader-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.6rem var(--space-5);
    border-bottom: var(--hairline) var(--line);
  }
  .rb-left,
  .rb-center,
  .rb-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .rb-toc,
  .rb-book {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .rb-toc:hover,
  .rb-book:hover {
    color: var(--cinnabar);
  }
  .rb-book {
    color: var(--text-dim);
    border-left: var(--hairline) var(--line);
    padding-left: var(--space-3);
  }
  .rb-progress {
    font-family: var(--font-latin-display);
    font-style: italic;
    color: var(--text-dim);
    font-size: var(--fs-sm);
  }
  .rb-btn {
    background: transparent;
    border: var(--hairline) var(--line);
    border-radius: var(--radius);
    color: var(--text-dim);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    padding: 0.3rem 0.55rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .rb-btn:hover {
    color: var(--text);
    border-color: var(--gold);
    box-shadow: var(--shadow-glow-gold);
  }
  .progress-track {
    max-width: 1100px;
    margin: 0 auto;
    height: 3px;
    background: var(--line);
  }
  .progress-track span {
    display: block;
    height: 100%;
    background: linear-gradient(to right, var(--cinnabar), var(--gold));
  }

  .reading-sheet {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-8);
    font-size: calc(var(--fs-md) * var(--type-scale));
  }
  .sheet-head {
    border-bottom: var(--hairline) var(--line);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    text-align: center;
  }
  .sheet-coup {
    display: inline-flex;
    gap: var(--space-4);
    align-items: center;
  }
  .sc-half {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    color: var(--text);
  }
  .sc-sep {
    width: 2px;
    height: 1.6rem;
    background: linear-gradient(to bottom, transparent, var(--cinnabar), transparent);
  }
  .sheet-coup.single .sc-half {
    font-size: var(--fs-2xl);
  }
  .sheet-chapter {
    display: block;
    margin-top: var(--space-3);
    color: var(--text-dim);
    font-family: var(--font-latin-display);
    font-style: italic;
    font-size: var(--fs-sm);
  }
  /* body, both directions */
  .sheet-body p {
    margin: 0 0 1.4em;
    color: var(--text);
    line-height: 2;
  }
  [data-dir="v"] .sheet-body {
    writing-mode: vertical-rl;
    text-orientation: upright;
    height: 78vh;
    column-count: auto;
    column-width: 30ch;
    column-gap: 3rem;
    column-rule: 1px solid var(--line);
  }
  [data-dir="v"] .sheet-body p {
    text-indent: 1em;
    margin: 0 0 0 2.4em;
  }
  [data-dir="v"] .sheet-head {
    writing-mode: vertical-rl;
    text-orientation: upright;
    text-align: left;
    border-bottom: none;
    border-right: var(--hairline) var(--line);
    padding: 0 0 0 var(--space-5);
    margin: 0 0 0 var(--space-5);
    float: right;
    min-height: 60vh;
    height: 70vh;
  }
  [data-dir="v"] .sheet-coup {
    flex-direction: column;
  }
  [data-dir="v"] .sc-sep {
    width: 2.5rem;
    height: 1px;
  }

  .sheet-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--hairline) var(--line);
  }
  [data-dir="v"] .sheet-nav {
    display: none;
  }
  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 46%;
  }
  .nav-next {
    text-align: right;
    margin-left: auto;
  }
  .nav-label {
    font-family: var(--font-latin-display);
    font-style: italic;
    color: var(--cinnabar);
    font-size: var(--fs-sm);
  }
  .nav-title {
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-md);
  }
  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--cinnabar);
  }
  .is-end {
    visibility: hidden;
  }

  @media (max-width: 700px) {
    .rb-book,
    .rb-center {
      display: none;
    }
    [data-dir="v"] .sheet-head {
      float: none;
      height: auto;
      min-height: 0;
    }
  }
</style>